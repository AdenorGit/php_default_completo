# =====================================================================
#  .ENV - Variáveis de ambiente da aplicação
#  
#  Este arquivo NUNCA deve ser versionado no Git (adicione ao .gitignore).
#  Ele contém credenciais sensíveis (senha do banco, futuramente chaves
#  de API, tokens etc.). O arquivo é lido pelo vlucas/phpdotenv no
#  Public/index.php:
#  
#      $dotenv = Dotenv\Dotenv::createImmutable(dirname(__DIR__));
#      $dotenv->load();
#  
#  As variáveis ficam disponíveis em $_ENV e via getenv(). O ConnDb
#  consome via ConnDb::fromEnv().
#  
#  ATENÇÃO: em produção, use variáveis de ambiente reais do sistema
#  (systemd, Docker, Apache SetEnv) em vez do arquivo .env — assim
#  as credenciais não ficam em disco.
# =====================================================================


# === BANCO DE DADOS ==================================================

# Host do servidor MySQL/MariaDB.
# 
# "localhost" → conexão via socket Unix (mais rápido no mesmo host)
# "127.0.0.1" → conexão via TCP na porta 3306
# "192.168.x.x" → MySQL em outro servidor da rede
# 
# Como o PHP e o MySQL rodam na mesma VM Debian, "localhost" é o
# mais eficiente (evita overhead de TCP).
DB_HOST=localhost

# Nome do banco de dados.
# 
# Este banco deve conter as tabelas:
#   - t_usuarios  (usu_id, usu_nome, usu_email, usu_senha, ...)
#   - t_eventos   (eve_id, eve_nome, eve_dt_evento, eve_fk_usu, ...)
DB_NAME=tarefas_db

# Usuário do MySQL/MariaDB.
# 
# O usuário "administrador" precisa ter permissões no banco tarefas_db:
#   - SELECT, INSERT, UPDATE, DELETE (operações da aplicação)
# 
# Para criar (se ainda não existir):
#   CREATE USER 'administrador'@'localhost' IDENTIFIED BY '123456';
#   GRANT SELECT, INSERT, UPDATE, DELETE ON tarefas_db.* TO 'administrador'@'localhost';
#   FLUSH PRIVILEGES;
DB_USER=administrador

# Senha do usuário acima.
# 
# ⚠️ NUNCA use senhas fracas como "123456" em produção.
# ⚠️ NUNCA commite este arquivo no Git (adicione ao .gitignore).
# ⚠️ Em produção, use senhas longas (16+ caracteres) com letras,
#    números e símbolos.
# 
# Para trocar a senha do usuário no MySQL:
#   ALTER USER 'administrador'@'localhost' IDENTIFIED BY 'novaSenhaForte';
#   FLUSH PRIVILEGES;
DB_PASS=123456